{
  "name": "fasla-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Fasla AI service: smart upload mapping, plan explanations and Q&A on the Anthropic API, with usage limits",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1175.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
