# ---- Production (Supabase) ----
AUTH_MODE=supabase
STORAGE_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...            # Project Settings > API keys > anon / publishable
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # Project Settings > API keys > service_role / secret. Server only, never in the browser.
# Connect > Session pooler connection string (port 5432). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Leave empty on new projects (tokens are checked with the public JWKS keys).
# Older projects that still sign with the legacy secret: Project Settings > JWT Keys > Legacy JWT secret.
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=fasla-files
GOOGLE_LOGIN=false
MAX_UPLOAD_MB=10
PLAN_WORKERS=1
SOLVER_SECONDS=25

# ---- Local development without Supabase ----
# AUTH_MODE=dev
# STORAGE_MODE=local
# DATABASE_URL=sqlite:///data/fasla.db
